# Copy this file to .env.local before adding real keys.
# Never commit .env.local.
NEXT_PUBLIC_SITE_NAME="陀思妥耶夫斯基 · 数字文学档案馆"

# Supabase public configuration. The anon key is intentionally constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only secrets. Never add NEXT_PUBLIC_ to these names.
SUPABASE_SERVICE_ROLE_KEY=""
COMMENT_RATE_LIMIT_SECRET=""
TURNSTILE_SECRET_KEY=""

# Cloudflare Turnstile public widget configuration.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Optional hostname assertion, for example: archive.example.com
TURNSTILE_EXPECTED_HOSTNAME=""
